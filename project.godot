; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Divine Punishment"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://src/autoload/tuning.gd"
EventBus="*res://src/autoload/event_bus.gd"
GameState="*res://src/autoload/game_state.gd"
SaveManager="*res://src/autoload/save_manager.gd"
MissionDirector="*res://src/autoload/mission_director.gd"
AudioDirector="*res://src/autoload/audio_director.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

